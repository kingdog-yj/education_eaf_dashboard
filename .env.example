# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 커밋되지 않습니다)

# --- LLM ---
# Discussion 채팅은 Claude Agent SDK(Claude Code 하네스)로 동작한다.
# 파일럿은 API 키가 필요 없다 — SDK가 스폰하는 CLI가 이 PC의
# Claude Code 로그인(구독) 자격증명을 그대로 상속한다.
# 팀 배포 등으로 API 키 인증이 필요해지면 아래 한 줄만 설정하면 전환된다.
# ANTHROPIC_API_KEY=sk-ant-...
# provider 구현체 선택 (현재 claude_agent 하나)
LLM_PROVIDER=claude_agent
# 채팅 모드(빠른 대화 / 심화 분석)의 모델·도구 선언은
# backend/app/llm/modes.py 한 곳에만 있다(.env 설정 아님).

# --- 앱 설정 ---
# 데이터 저장소: file (parquet/csv 더미) | sql (향후 사내 DB)
DATA_BACKEND=file
# 더미/파일 데이터 루트 디렉토리
DATA_DIR=./data/dummy

# --- 향후 사내 DB 연결용 (현재 미사용) ---
# MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...
# ORACLE_DSN=host:port/service
