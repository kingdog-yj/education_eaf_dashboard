# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 커밋되지 않습니다)

# --- LLM ---
OPENAI_API_KEY=sk-...
# 향후 Claude 전환 시 사용 (llm provider 교체)
# ANTHROPIC_API_KEY=sk-ant-...

# --- 학술 검색 (선택) ---
# 무료 발급: https://www.semanticscholar.org/product/api#api-key-form
# 없어도 동작하나 공용 rate limit으로 429가 잦을 수 있음
# SEMANTIC_SCHOLAR_API_KEY=

# --- 앱 설정 ---
# LLM provider 선택: openai | anthropic
LLM_PROVIDER=openai
# 채팅 기본 모델. 선택지는 backend/app/llm/options.py 선언 참조
# (gpt-5-mini | gpt-5 | gpt-5-nano). 기본 gpt-5-mini — 수 초 내 응답 우선.
# LLM_MODEL=gpt-5-mini
# 기본 reasoning 강도: minimal | low | medium | high (빈 값이면 모델 기본값 유지).
# 기본 low. 높일수록 답변이 깊어지지만 첫 토큰까지의 지연이 크게 늘어난다
# (gpt-5 기본 강도에서 첫 토큰까지 100초대가 관측됨).
# LLM_REASONING_EFFORT=low
# 응답 상세도: low | medium | high (그 외 값이면 모델 기본값 유지).
# 기본 low — 현업 전문가 대상 디스커션은 결론·수치 우선이라 장황한 응답을 억제한다.
# 서술형 해설이 더 필요하면 medium으로 올린다.
# LLM_VERBOSITY=low
# ※ 위 두 값은 서버 기본값일 뿐이며, 사용자는 채팅 UI에서 메시지 단위로
#    모델/강도를 바꿀 수 있다(재기동 불필요).
# 데이터 저장소: file (parquet/csv 더미) | sql (향후 사내 DB)
DATA_BACKEND=file
# 더미/파일 데이터 루트 디렉토리
DATA_DIR=./data/dummy

# --- 향후 사내 DB 연결용 (현재 미사용) ---
# MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...
# ORACLE_DSN=host:port/service
